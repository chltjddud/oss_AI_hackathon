# 배포 및 서버 환경 변수
DEPLOY_USER_ID=your_deploy_user_id
DEPLOY_PASSWORD=your_deploy_password
DEPLOY_HOST=your_deploy_host
DEPLOY_ADDRESS=https://your_deploy_address/
DEPLOY_WORK_PATH=/home/user/html/
INTERNAL_HOST=127.0.0.1
PORT=3102

# Supabase 환경 변수
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 외부 연동 API 키
YOUTH_CENTER_API_KEY=your_youth_center_api_key
PUBLIC_DATA_API_KEY=your_public_data_api_key
GEMINI_API_KEY=your_gemini_api_key
